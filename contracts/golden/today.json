{
  "_comment": "GOLDEN CASES — ground truth for the Today execution overlay (CLAUDE.md §7 law 4, §10 law 6; SPEC §3.7). AGENT-AUTHORED PROPOSAL: the operator reviews and freezes. These exist because the v0.3 cold review found a BLOCKING cap bypass that 206 passing tests missed, and its diagnosis was exact — there was no golden file for Today, so no externality could catch it. Executed by src-tauri/src/golden_runner.rs; a case here is a real transaction against a real database, not a description of one.",
  "module": "commands::day::{add_to_today_inner, open_day_inner, roll_day_inner, today_overflow_draft} + the re-activation doors in commands::items",
  "version": 1,
  "_status": "proposed",
  "_dates": { "D1": "2026-07-25", "D2": "2026-07-26" },
  "cases": [
    {
      "name": "cap: 3 active allowed on a date, the 4th is refused",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "create", "tier": "A", "content": "t1", "rank": "n" },
        { "type": "create", "tier": "A", "content": "t2", "rank": "o" },
        { "type": "create", "tier": "A", "content": "t3", "rank": "p" },
        { "type": "today", "item_index": 0, "date": "D2" },
        { "type": "today", "item_index": 1, "date": "D2" },
        { "type": "today", "item_index": 2, "date": "D2" },
        { "type": "today", "item_index": 3, "date": "D2", "expect_error": "TODAY_FULL" }
      ],
      "expect_today_active": { "D2": 3 }
    },
    {
      "name": "only active items may be chosen for Today",
      "ops": [
        { "type": "create", "tier": "A", "content": "blocked one", "rank": "m" },
        { "type": "set_state", "item_index": 0, "state": "blocked", "blocked_reason": "waiting" },
        { "type": "today", "item_index": 0, "date": "D2", "expect_error": "NOT_ACTIVE" }
      ],
      "expect_today_active": { "D2": 0 }
    },
    {
      "name": "a finished Today item keeps its membership but frees its slot",
      "description": "The progress-visibility rule: completed work stays in sight, and the day still has room for a replacement.",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "create", "tier": "A", "content": "t1", "rank": "n" },
        { "type": "create", "tier": "A", "content": "t2", "rank": "o" },
        { "type": "create", "tier": "A", "content": "t3", "rank": "p" },
        { "type": "today", "item_index": 0, "date": "D2" },
        { "type": "today", "item_index": 1, "date": "D2" },
        { "type": "today", "item_index": 2, "date": "D2" },
        { "type": "set_state", "item_index": 0, "state": "done" },
        { "type": "today", "item_index": 3, "date": "D2" }
      ],
      "expect_today_active": { "D2": 3 },
      "expect_today_total": { "D2": 4 },
      "expect_on_today": { "0": "D2" }
    },
    {
      "name": "REACTIVATION into a full day drops membership rather than failing",
      "description": "The v0.3 BLOCKING bug. t0 is done-but-still-on-Today; its freed slot has been taken by t3. Marking t0 active again MUST succeed — undo of a completion takes this exact path and undo may never fail — and MUST NOT put 4 active on the date, so t0 leaves Today.",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "create", "tier": "A", "content": "t1", "rank": "n" },
        { "type": "create", "tier": "A", "content": "t2", "rank": "o" },
        { "type": "create", "tier": "A", "content": "t3", "rank": "p" },
        { "type": "today", "item_index": 0, "date": "D2" },
        { "type": "today", "item_index": 1, "date": "D2" },
        { "type": "today", "item_index": 2, "date": "D2" },
        { "type": "set_state", "item_index": 0, "state": "done" },
        { "type": "today", "item_index": 3, "date": "D2" },
        { "type": "set_state", "item_index": 0, "state": "active" }
      ],
      "expect_today_active": { "D2": 3 },
      "expect_on_today": { "0": null },
      "expect_last_today_removed_cause": "user"
    },
    {
      "name": "reactivation keeps membership when the day has room",
      "description": "The guard must not fire needlessly.",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "today", "item_index": 0, "date": "D2" },
        { "type": "set_state", "item_index": 0, "state": "done" },
        { "type": "set_state", "item_index": 0, "state": "active" }
      ],
      "expect_today_active": { "D2": 1 },
      "expect_on_today": { "0": "D2" }
    },
    {
      "name": "restore into a full day drops membership",
      "description": "The same entry-path rule on the archive door (cf. caps.json #12, the P2e JOINT_WRONG).",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "create", "tier": "A", "content": "t1", "rank": "n" },
        { "type": "create", "tier": "A", "content": "t2", "rank": "o" },
        { "type": "create", "tier": "A", "content": "t3", "rank": "p" },
        { "type": "today", "item_index": 0, "date": "D2" },
        { "type": "today", "item_index": 1, "date": "D2" },
        { "type": "today", "item_index": 2, "date": "D2" },
        { "type": "delete", "item_index": 0 },
        { "type": "today", "item_index": 3, "date": "D2" },
        { "type": "restore", "item_index": 0 }
      ],
      "expect_today_active": { "D2": 3 },
      "expect_on_today": { "0": null }
    },
    {
      "name": "open_day is atomic: an over-cap ceremony writes nothing at all",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "create", "tier": "A", "content": "t1", "rank": "n" },
        { "type": "create", "tier": "A", "content": "t2", "rank": "o" },
        { "type": "create", "tier": "A", "content": "t3", "rank": "p" },
        { "type": "open_day", "date": "D2", "item_indices": [0, 1, 2, 3], "expect_error": "TODAY_FULL" }
      ],
      "expect_today_active": { "D2": 0 },
      "expect_event_counts": { "TODAY_ADDED": 0, "DAY_OPENED": 0 }
    },
    {
      "name": "open_day is idempotent: re-opening with the same ids adds nothing",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "create", "tier": "A", "content": "t1", "rank": "n" },
        { "type": "open_day", "date": "D2", "item_indices": [0, 1] },
        { "type": "open_day", "date": "D2", "item_indices": [0, 1] }
      ],
      "expect_today_active": { "D2": 2 },
      "expect_event_counts": { "TODAY_ADDED": 2, "DAY_OPENED": 2 }
    },
    {
      "name": "moving an item to another date balances the old date's events",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "today", "item_index": 0, "date": "D1" },
        { "type": "today", "item_index": 0, "date": "D2" }
      ],
      "expect_on_today": { "0": "D2" },
      "expect_event_counts": { "TODAY_ADDED": 2, "TODAY_REMOVED": 1 }
    },
    {
      "name": "the day-roll expires only PAST dates, as the system actor",
      "ops": [
        { "type": "create", "tier": "A", "content": "yesterday", "rank": "m" },
        { "type": "create", "tier": "A", "content": "today", "rank": "n" },
        { "type": "today", "item_index": 0, "date": "D1" },
        { "type": "today", "item_index": 1, "date": "D2" },
        { "type": "roll_day", "date": "D2" }
      ],
      "expect_on_today": { "0": null, "1": "D2" },
      "expect_last_today_removed_cause": "expired",
      "expect_last_today_removed_actor": "system",
      "expect_last_today_removed_origin": "day_roll"
    },
    {
      "name": "the day-roll is idempotent: a second roll writes no events",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "today", "item_index": 0, "date": "D1" },
        { "type": "roll_day", "date": "D2" },
        { "type": "roll_day", "date": "D2" }
      ],
      "expect_event_counts": { "TODAY_REMOVED": 1 }
    },
    {
      "name": "undo of a date move restores the ORIGINAL date",
      "description": "The move is one transaction of two events, so one Ctrl+Z unwinds both.",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "today", "item_index": 0, "date": "D1" },
        { "type": "today", "item_index": 0, "date": "D2" },
        { "type": "undo" }
      ],
      "expect_on_today": { "0": "D1" }
    },
    {
      "name": "ACCEPT-DIFF: a finished item keeps its Today membership",
      "description": "Case 3's rule, asserted at the door that broke it. An item unblocked AND completed in one accepted re-org is not competing for a Today slot (done items hold none), so its membership must survive — and no TODAY_REMOVED may be written for it. The runner could not reach accept_suggestion before, which is exactly why a violation shipped while case 3 passed. NOTE the ranks: `y` (the completed one) is deliberately the WORST-ranked contender, so the eviction loop reaches it FIRST and must skip it for being done. Rank them the other way and the case still passes while the rule is broken — it evicts `z`, satisfies the cap, and never evaluates `y` at all.",
      "ops": [
        { "type": "create", "tier": "B", "content": "y", "rank": "n" },
        { "type": "today", "item_index": 0, "date": "D2" },
        { "type": "set_state", "item_index": 0, "state": "blocked", "blocked_reason": "stuck" },
        { "type": "create", "tier": "B", "content": "z", "rank": "m" },
        { "type": "today", "item_index": 1, "date": "D2" },
        { "type": "set_state", "item_index": 1, "state": "blocked", "blocked_reason": "stuck" },
        { "type": "create", "tier": "A", "content": "f0", "rank": "m" },
        { "type": "create", "tier": "A", "content": "f1", "rank": "n" },
        { "type": "create", "tier": "A", "content": "f2", "rank": "o" },
        { "type": "today", "item_index": 2, "date": "D2" },
        { "type": "today", "item_index": 3, "date": "D2" },
        { "type": "today", "item_index": 4, "date": "D2" },
        {
          "type": "accept_reorg",
          "ops": [
            { "item_index": 0, "action": "active" },
            { "item_index": 0, "action": "done" },
            { "item_index": 1, "action": "active" }
          ]
        }
      ],
      "expect_on_today": { "0": "D2", "1": null },
      "expect_today_active": { "D2": 3 },
      "expect_event_counts": { "TODAY_REMOVED": 1 }
    },
    {
      "name": "ACCEPT-DIFF: completing a blocked item leaves undo working",
      "description": "Every done-door must carry the outgoing blocked reason, or undo writes a blocked row with a null reason, trips the migration-002 CHECK, rolls back, and stays dead on that transaction. The accept path was the last door missing it.",
      "ops": [
        { "type": "create", "tier": "A", "content": "stuck work", "rank": "m" },
        { "type": "set_state", "item_index": 0, "state": "blocked", "blocked_reason": "waiting on legal" },
        {
          "type": "accept_reorg",
          "ops": [{ "item_index": 0, "action": "done" }]
        },
        { "type": "undo" }
      ],
      "expect_item_state": { "0": "blocked" },
      "expect_item_blocked_reason": { "0": "waiting on legal" }
    },
    {
      "name": "the day-roll is not an undo target",
      "description": "Law 10: the roll executes a timer the human set, so Ctrl+Z looks past it to the last HUMAN action — here the add.",
      "ops": [
        { "type": "create", "tier": "A", "content": "t0", "rank": "m" },
        { "type": "today", "item_index": 0, "date": "D1" },
        { "type": "roll_day", "date": "D2" },
        { "type": "undo" }
      ],
      "expect_on_today": { "0": null },
      "expect_undone_event_types": ["TODAY_ADDED"]
    }
  ]
}
